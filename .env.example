# Google AI Studio (Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended model for new Google AI Studio keys (gemini-2.5-flash-lite is deprecated — auto-mapped to 3.5)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite
# Optional override for the automated trading Planner agent
GEMINI_PLANNER_MODEL=gemini-3.5-flash-lite
# Planner: auto (try Gemini with timeout, then fallback) | fallback | off
PLANNER_PROVIDER=auto
PLANNER_GEMINI_TIMEOUT_MS=12000
PLANNER_GEMINI_MAX_MODELS=2
INTENT_NEWS_TIMEOUT_MS=8000

# Execution Engine — sandbox dry-run by default (only execution service calls Alpaca orders)
EXECUTION_SANDBOX=true
# Set EXECUTION_LIVE=true to allow paper broker submits from the UI toggle
EXECUTION_LIVE=false
ALPACA_COMMAND_TIMEOUT_MS=30000
EXECUTION_BROKER_TIMEOUT_MS=25000
# Sandbox Auto Trade uses simulated orders (fast, no Alpaca). Set false to use alpaca --dry-run.
EXECUTION_MOCK_SANDBOX=true

# auto = Gemini when available, Alpaca on quota/errors (recommended)
# gemini = Gemini only
# alpaca = Alpaca news only (no Gemini quota usage)
NEWS_PROVIDER=auto

# Delay between Gemini analysis passes (ms) — helps free-tier rate limits
GEMINI_ANALYSIS_PASS_DELAY_MS=800

# Analysis cache (minutes) and assumptions
ANALYSIS_CACHE_MINUTES=30
ANALYSIS_BENCHMARK=SPY
ANALYSIS_RISK_FREE_RATE=0

# Google Search grounding uses extra quota — keep false on free tier
GEMINI_USE_SEARCH=false

# Cache Gemini responses per symbol (minutes)
GEMINI_NEWS_CACHE_MINUTES=120

# After quota error, pause Gemini calls (minutes)
GEMINI_QUOTA_COOLDOWN_MINUTES=180

PORT=3000
